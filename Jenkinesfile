pipeline {
    agent any

    tools {
        jdk 'JDK17'
        maven 'Maven3.9.9'
    }

    environment {
        IMAGE_NAME = 'springboot-docker-jenkins-demo'
        IMAGE_TAG = '1.0'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean compile'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Package') {
            steps {
                sh 'mvn package -DskipTests'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .'
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check the console output for errors.'
        }

        always {
            echo 'Jenkins pipeline execution finished.'
        }
    }
}